# Runtime environment variables; no default account is created.
OPSPILOT_DB=./opspilot_demo.sqlite3
# false is for loopback HTTP only. HTTPS ingress requires true.
OPSPILOT_SECURE_COOKIE=false
# User creation accepts one-use OPSPILOT_INITIAL_PASSWORD or interactive getpass.
# Never commit real passwords. The server does not read this password variable.
